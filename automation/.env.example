# Copy this file to automation/.env and fill in real values.
# .env is read by run_sync.sh and is gitignored.

BRIDGE_URL=https://REPLACE-ME.onrender.com/api/external-progress
EXTERNAL_PROGRESS_TOKEN=REPLACE-ME

# Path to a Chrome user-data dir that has the Scroll Mile extension installed.
# Easiest: create a dedicated profile directory once, install Scroll Mile in it,
# then point USER_DATA_DIR at that folder. Example:
#   USER_DATA_DIR=/Users/guykowen/Library/Application Support/ScrollMileSyncProfile
USER_DATA_DIR=/Users/guykowen/Library/Application Support/ScrollMileSyncProfile

# Optional overrides
# EXTENSION_ID=kdeibhcngffpofgiaglnbhfpiocffihh
# HEADLESS=0
# TIMEOUT_MS=20000
# PYTHON_BIN=/usr/local/bin/python3
