# Copy this file to automation/.env and fill in real values.
# .env is read by run_sync.sh and is gitignored.

BRIDGE_URL=https://REPLACE-ME.onrender.com/api/external-progress
EXTERNAL_PROGRESS_TOKEN=REPLACE-ME

# Dedicated folder Playwright uses as Chrome user-data-dir (must not be your real
# ~/Library/.../Google/Chrome — Chrome blocks automation there). Install Scroll Mile
# there once, OR enable mirroring from your real profile (see below).
USER_DATA_DIR="/Users/you/scroll-mile-sync-profile"

# Set to 1 to rsync Scroll Mile extension data from your real Chrome Default profile
# into USER_DATA_DIR before each run. Chrome must be fully quit first.
MIRROR_SCROLL_MILE_FROM_CHROME=1
# CHROME_USER_DATA_FOR_MIRROR="/Users/you/Library/Application Support/Google/Chrome"
# EXTENSION_ID_FOR_MIRROR=kdeibhcngffpofgiaglnbhfpiocffihh

# Optional overrides
# EXTENSION_ID=kdeibhcngffpofgiaglnbhfpiocffihh
# HEADLESS=0
# TIMEOUT_MS=20000
# PYTHON_BIN=/usr/local/bin/python3
